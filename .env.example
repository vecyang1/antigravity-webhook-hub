# ==============================================================================
# Antigravity Webhook Hub — Environment Variables Configuration Contract
# ==============================================================================
# All parameters are configurable with clean precedence:
# CLI / Explicit Flags > .env > config.yaml > Built-in Secure Defaults

# --- Server Networking ---
# Host interface to bind on (use 127.0.0.1 for local isolation via Cloudflare Tunnel)
HOST=127.0.0.1
# Non-standard HTTP port (default: 9423)
PORT=9423
# Maximum allowed payload size in bytes (default: 1048576 = 1MB)
MAX_BODY_BYTES=1048576
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# HTTP keep-alive timeout in seconds
KEEP_ALIVE_TIMEOUT=65

# --- Security & Authentication ---
# Authentication mode: hmac | bearer | any | both (default: hmac)
AUTH_MODE=hmac
# Shared secret for HMAC SHA-256 signature verification (minimum 32 characters)
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your_hmac_secret_here_min_32_chars
# Bearer token for direct programmatic API access
# Generate with: openssl rand -hex 32
BEARER_TOKEN=your_bearer_token_here_min_32_chars
# Tolerance window in seconds for past timestamps to defeat replay attacks (default: 300)
TIMESTAMP_TOLERANCE_SECONDS=300
# Tolerance window in seconds for future timestamp rejection (default: 60)
FUTURE_TIMESTAMP_TOLERANCE_SECONDS=60
# Header names for signature, timestamp, and client event ID
SIGNATURE_HEADER=X-Hub-Signature-256
TIMESTAMP_HEADER=X-Hub-Timestamp
EVENT_ID_HEADER=X-Hub-Event-ID

# --- Database & Persistence ---
# SQLite database file path (persisted Single Source of Truth)
DATABASE_PATH=data/webhook_hub.db
# Enable Write-Ahead Logging for high concurrency without blocking reads
DATABASE_WAL_MODE=true
# SQLite busy timeout in milliseconds to prevent database locks
DATABASE_BUSY_TIMEOUT_MS=5000

# --- Dispatch & Execution ---
# Maximum execution time in seconds for dispatched actions before timeout kill
DEFAULT_ACTION_TIMEOUT_SECONDS=300
# Maximum concurrent tasks executed by the async worker
MAX_CONCURRENT_TASKS=5

# --- Cloudflare Tunnel ---
# Name of the configured Cloudflare Tunnel
CLOUDFLARE_TUNNEL_NAME=antigravity-webhook-tunnel
# Public hostname routed to this tunnel instance
CLOUDFLARE_TUNNEL_HOSTNAME=webhook.yourdomain.com
# Path to Cloudflare credentials JSON file
CLOUDFLARE_CREDENTIALS_FILE=~/.cloudflared/credentials.json

# --- Antigravity Watchdog & Resuscitation ---
ANTIGRAVITY_WATCHDOG_ENABLED=true
ANTIGRAVITY_WATCHDOG_INTERVAL_SECONDS=15
ANTIGRAVITY_WATCHDOG_LOOKBACK_MINUTES=720
ANTIGRAVITY_WATCHDOG_STALL_GRACE_SECONDS=15
ANTIGRAVITY_WATCHDOG_BOOST_QUIET_SECONDS=45
ANTIGRAVITY_WATCHDOG_MAX_RETRIES_PER_SESSION=3
ANTIGRAVITY_WATCHDOG_AUTO_RESUSCITATE=true

# --- Antigravity Quota Sentinel & Fleet Warmup ---
ANTIGRAVITY_QUOTA_ENABLED=true
ANTIGRAVITY_QUOTA_SCAN_INTERVAL_SECONDS=120
ANTIGRAVITY_QUOTA_AUTO_WARMUP_5H=true
ANTIGRAVITY_QUOTA_AUTO_WARMUP_WEEKLY=false
# Autonomous fleet-wide warmup: warms all standby accounts before user profile switches (default: true)
ANTIGRAVITY_QUOTA_WARMUP_ALL_ACCOUNTS=true
# 4h 55m cooldown (seconds) between warmups to prevent burning quota
ANTIGRAVITY_QUOTA_WARMUP_COOLDOWN_SECONDS=17700
ANTIGRAVITY_QUOTA_TOOLS_API_HOST=127.0.0.1
ANTIGRAVITY_QUOTA_TOOLS_API_PORT=8045
ANTIGRAVITY_QUOTA_TOOLS_API_TIMEOUT_SECONDS=15.0

