<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.antigravity-webhook-hub</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/antigravity-webhook-hub/tunnel/manage_daemon.sh</string>
        <string>run</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/path/to/antigravity-webhook-hub</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/path/to/antigravity-webhook-hub/webhook-hub.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/antigravity-webhook-hub/webhook-hub-err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>ProcessType</key>
    <string>Standard</string>
</dict>
</plist>
